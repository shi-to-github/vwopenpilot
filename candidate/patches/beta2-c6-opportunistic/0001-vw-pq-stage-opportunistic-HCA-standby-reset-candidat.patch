+++ b/selfdrive/car/volkswagen/hca_opportunistic_reset.py
@@ -0,0 +1,86 @@
+"""Candidate low-torque opportunity reset for PQ HCA timers.
+
+Disabled by default. This ports the strategy from opendbc PR #3129 to the
+older Dragonpilot controller without enabling it on a device.
+"""
+
+PQ_OPPORTUNISTIC_RESET_ENABLED = False
+PQ_SEARCH_AFTER_S = 240.0
+PQ_ALERT_AFTER_S = 350.0
+PQ_LOW_TORQUE_FRACTION = 0.20
+PQ_LOW_TORQUE_HOLD_S = 0.5
+PQ_STANDBY_S = 2.0
+
+
+class HcaOpportunisticReset:
+  def __init__(self, message_hz, steer_max, search_after_s=PQ_SEARCH_AFTER_S,
+               alert_after_s=PQ_ALERT_AFTER_S,
+               low_torque_fraction=PQ_LOW_TORQUE_FRACTION,
+               low_torque_hold_s=PQ_LOW_TORQUE_HOLD_S,
+               standby_s=PQ_STANDBY_S):
+    self.message_hz = message_hz
+    self.search_after_frames = int(round(search_after_s * message_hz))
+    self.alert_after_frames = int(round(alert_after_s * message_hz))
+    self.low_torque_threshold = int(round(steer_max * low_torque_fraction))
+    self.low_torque_hold_frames = int(round(low_torque_hold_s * message_hz))
+    self.required_standby_frames = int(round(standby_s * message_hz))
+    self.active_frames = 0
+    self.low_torque_frames = 0
+    self.standby_frames = 0
+    self.natural_standby_frames = 0
+    self.forcing_standby = False
+    self.approaching_timeout = False
+
+  def reset(self):
+    self.active_frames = 0
+    self.low_torque_frames = 0
+    self.standby_frames = 0
+    self.natural_standby_frames = 0
+    self.forcing_standby = False
+    self.approaching_timeout = False
+
+  def update(self, lat_active, requested_torque, demand_torque=None):
+    """Return torque, HCA enabled, reset completed, reset aborted."""
+    if not lat_active:
+      self.reset()
+      return 0, False, False, False
+
+    if demand_torque is None:
+      demand_torque = requested_torque
+
+    self.active_frames += 1
+    self.approaching_timeout = self.active_frames >= self.alert_after_frames
+
+    if self.forcing_standby:
+      if abs(demand_torque) > self.low_torque_threshold:
+        self.low_torque_frames = 0
+        self.standby_frames = 0
+        self.forcing_standby = False
+        return requested_torque, requested_torque != 0, False, True
+
+      self.standby_frames += 1
+      completed = self.standby_frames >= self.required_standby_frames
+      if completed:
+        self.reset()
+      return 0, False, completed, False
+
+    if requested_torque == 0:
+      self.natural_standby_frames += 1
+      completed = self.natural_standby_frames >= self.required_standby_frames
+      if completed:
+        self.reset()
+      return 0, False, completed, False
+
+    self.natural_standby_frames = 0
+
+    if self.active_frames >= self.search_after_frames:
+      if abs(requested_torque) <= self.low_torque_threshold:
+        self.low_torque_frames += 1
+        if self.low_torque_frames >= self.low_torque_hold_frames:
+          self.forcing_standby = True
+          self.standby_frames = 1
+          return 0, False, self.required_standby_frames == 1, False
+      else:
+        self.low_torque_frames = 0
+
+    return requested_torque, True, False, False
