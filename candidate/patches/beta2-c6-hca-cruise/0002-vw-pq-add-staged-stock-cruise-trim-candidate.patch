diff --git a/selfdrive/car/volkswagen/pq_stock_cruise.py b/selfdrive/car/volkswagen/pq_stock_cruise.py
new file mode 100644
index 0000000..59895bc
--- /dev/null
+++ b/selfdrive/car/volkswagen/pq_stock_cruise.py
@@ -0,0 +1,237 @@
+from dataclasses import dataclass
+from enum import IntEnum
+from pathlib import Path
+from typing import Optional
+
+
+class StockCruiseMode(IntEnum):
+  off = 0
+  observe = 1
+  manual_test = 2
+  lead_trim = 3
+
+
+class ButtonCommand(IntEnum):
+  none = 0
+  accel = 1
+  decel = 2
+
+
+@dataclass
+class LeadSample:
+  status: bool = False
+  d_rel_m: float = 0.0
+  y_rel_m: float = 0.0
+  v_rel_ms: float = 0.0
+  v_lead_ms: float = 0.0
+  model_prob: float = 0.0
+
+
+@dataclass
+class StockCruiseOutput:
+  command: ButtonCommand
+  driver_ceiling_kph: float
+  temporary_target_kph: float
+  waiting_for_ack: bool
+  faulted: bool
+  reason: str
+
+
+def read_mode(path="/data/pq46/stock_cruise_mode"):
+  """Read a raw file so this candidate does not require rebuilding Params or the UI."""
+  try:
+    value = int(Path(path).read_text(encoding="utf-8").strip())
+    return StockCruiseMode(value)
+  except (OSError, ValueError):
+    return StockCruiseMode.off
+
+
+def consume_manual_command(path="/data/pq46/stock_cruise_test_command"):
+  command_path = Path(path)
+  try:
+    value = command_path.read_text(encoding="utf-8").strip().lower()
+    command_path.unlink()
+  except OSError:
+    return ButtonCommand.none
+
+  if value in ("up", "accel", "+"):
+    return ButtonCommand.accel
+  if value in ("down", "decel", "-"):
+    return ButtonCommand.decel
+  return ButtonCommand.none
+
+
+class PqStockCruiseController:
+  """Closed-loop stock cruise setpoint manager; it never commands throttle or brakes."""
+
+  def __init__(self, mode=StockCruiseMode.off, control_hz=100, min_target_kph=55.0,
+               lead_confirm_s=1.0, lead_lost_s=2.0, button_interval_s=0.5,
+               ack_timeout_s=1.5, desired_time_gap_s=2.0):
+    self.mode = StockCruiseMode(mode)
+    self.control_hz = control_hz
+    self.min_target_kph = min_target_kph
+    self.lead_confirm_frames = round(lead_confirm_s * control_hz)
+    self.lead_lost_frames = round(lead_lost_s * control_hz)
+    self.button_interval_frames = round(button_interval_s * control_hz)
+    self.ack_timeout_frames = round(ack_timeout_s * control_hz)
+    self.desired_time_gap_s = desired_time_gap_s
+
+    self.driver_ceiling_kph = 0.0
+    self.temporary_target_kph = 0.0
+    self.pending_command = ButtonCommand.none
+    self.waiting_command = ButtonCommand.none
+    self.sent_set_speed_kph = 0.0
+    self.ack_frames = 0
+    self.cooldown_frames = 0
+    self.lead_valid_frames = 0
+    self.lead_lost_frames_count = 0
+    self.lead_latched = False
+    self.driver_override_frames = 0
+    self.capture_driver_setpoint = False
+    self.faulted = False
+    self.reason = "off"
+
+  def reset_session(self):
+    self.driver_ceiling_kph = 0.0
+    self.temporary_target_kph = 0.0
+    self.pending_command = ButtonCommand.none
+    self.waiting_command = ButtonCommand.none
+    self.sent_set_speed_kph = 0.0
+    self.ack_frames = 0
+    self.cooldown_frames = 0
+    self.lead_valid_frames = 0
+    self.lead_lost_frames_count = 0
+    self.lead_latched = False
+    self.driver_override_frames = 0
+    self.capture_driver_setpoint = False
+    self.faulted = False
+    self.reason = "inactive"
+
+  def queue_manual_command(self, command):
+    if self.mode == StockCruiseMode.manual_test and self.pending_command == ButtonCommand.none \
+        and self.waiting_command == ButtonCommand.none and not self.faulted:
+      self.pending_command = ButtonCommand(command)
+      self.reason = "manual command queued"
+
+  def _lead_is_detected(self, lead: Optional[LeadSample]):
+    if lead is None or not lead.status or lead.model_prob < 0.70 or abs(lead.y_rel_m) > 1.8:
+      return False
+    return True
+
+  def _lead_should_trigger(self, lead: Optional[LeadSample], v_ego_ms):
+    if not self._lead_is_detected(lead):
+      return False
+    desired_gap_m = max(10.0, v_ego_ms * self.desired_time_gap_s)
+    closing_buffer_m = max(0.0, -lead.v_rel_ms) * 5.0
+    return lead.v_rel_ms < -0.5 and lead.d_rel_m <= desired_gap_m + closing_buffer_m
+
+  def _latched_lead_still_relevant(self, lead: Optional[LeadSample], v_ego_ms):
+    if not self._lead_is_detected(lead):
+      return False
+    desired_gap_m = max(10.0, v_ego_ms * self.desired_time_gap_s)
+    return lead.d_rel_m <= desired_gap_m * 1.5
+
+  def _acknowledge_or_timeout(self, set_speed_kph):
+    if self.waiting_command == ButtonCommand.none:
+      return
+
+    changed_down = self.waiting_command == ButtonCommand.decel and set_speed_kph <= self.sent_set_speed_kph - 0.5
+    changed_up = self.waiting_command == ButtonCommand.accel and set_speed_kph >= self.sent_set_speed_kph + 0.5
+    if changed_down or changed_up:
+      self.waiting_command = ButtonCommand.none
+      self.ack_frames = 0
+      self.reason = "setpoint acknowledged"
+      return
+
+    self.ack_frames += 1
+    if self.ack_frames >= self.ack_timeout_frames:
+      self.waiting_command = ButtonCommand.none
+      self.pending_command = ButtonCommand.none
+      self.faulted = True
+      self.reason = "setpoint acknowledgement timeout"
+
+  def mark_command_sent(self, set_speed_kph):
+    if self.pending_command == ButtonCommand.none:
+      return
+    self.waiting_command = self.pending_command
+    self.pending_command = ButtonCommand.none
+    self.sent_set_speed_kph = set_speed_kph
+    self.ack_frames = 0
+    self.cooldown_frames = self.button_interval_frames
+    self.reason = "waiting for setpoint acknowledgement"
+
+  def update(self, active, set_speed_kph, v_ego_ms, brake_pressed=False, gas_pressed=False,
+             driver_button_active=False, lead: Optional[LeadSample] = None):
+    if self.mode == StockCruiseMode.off:
+      self.reset_session()
+      self.reason = "off"
+      return self.output()
+
+    if not active or brake_pressed or set_speed_kph <= 0.0:
+      self.reset_session()
+      return self.output()
+
+    if self.driver_ceiling_kph <= 0.0:
+      self.driver_ceiling_kph = set_speed_kph
+      self.temporary_target_kph = set_speed_kph
+
+    if self.cooldown_frames > 0:
+      self.cooldown_frames -= 1
+    if self.driver_override_frames > 0:
+      self.driver_override_frames -= 1
+
+    if driver_button_active:
+      self.pending_command = ButtonCommand.none
+      self.waiting_command = ButtonCommand.none
+      self.ack_frames = 0
+      self.driver_override_frames = self.control_hz
+      self.capture_driver_setpoint = True
+      self.reason = "driver button override"
+      return self.output()
+
+    if self.capture_driver_setpoint and self.driver_override_frames == 0:
+      self.driver_ceiling_kph = set_speed_kph
+      self.temporary_target_kph = set_speed_kph
+      self.capture_driver_setpoint = False
+      self.reason = "driver ceiling updated"
+
+    self._acknowledge_or_timeout(set_speed_kph)
+    if self.faulted or gas_pressed or self.driver_override_frames > 0:
+      return self.output()
+
+    if self.mode in (StockCruiseMode.observe, StockCruiseMode.lead_trim):
+      lead_relevant = self._latched_lead_still_relevant(lead, v_ego_ms) if self.lead_latched \
+        else self._lead_should_trigger(lead, v_ego_ms)
+      if lead_relevant:
+        self.lead_valid_frames += 1
+        self.lead_lost_frames_count = 0
+      else:
+        self.lead_valid_frames = 0
+        self.lead_lost_frames_count += 1
+
+      if self.lead_valid_frames >= self.lead_confirm_frames and lead is not None:
+        self.lead_latched = True
+        lead_target_kph = max(self.min_target_kph, round(lead.v_lead_ms * 3.6))
+        self.temporary_target_kph = min(self.driver_ceiling_kph, lead_target_kph)
+        self.reason = "confirmed slower lead"
+      elif self.lead_lost_frames_count >= self.lead_lost_frames:
+        self.lead_latched = False
+        self.temporary_target_kph = self.driver_ceiling_kph
+        self.reason = "lead clear; restoring driver ceiling"
+
+    if self.mode != StockCruiseMode.lead_trim or self.waiting_command != ButtonCommand.none \
+        or self.pending_command != ButtonCommand.none or self.cooldown_frames > 0:
+      return self.output()
+
+    if set_speed_kph > self.temporary_target_kph + 0.5:
+      self.pending_command = ButtonCommand.decel
+      self.reason = "request one setpoint decrement"
+    elif set_speed_kph < self.temporary_target_kph - 0.5 and set_speed_kph < self.driver_ceiling_kph - 0.5:
+      self.pending_command = ButtonCommand.accel
+      self.reason = "request one setpoint increment"
+
+    return self.output()
+
+  def output(self):
+    return StockCruiseOutput(self.pending_command, self.driver_ceiling_kph, self.temporary_target_kph,
+                             self.waiting_command != ButtonCommand.none, self.faulted, self.reason)
