@@ -0,0 +1,116 @@
+import tempfile
+import unittest
+from pathlib import Path
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from pq_stock_cruise import (ButtonCommand, LeadSample, PqStockCruiseController, StockCruiseMode,
+                             consume_manual_command, read_mode)
+import pqcan
+
+
+class FakePacker:
+  def make_can_msg(self, name, bus, values):
+    return name, bus, values
+
+
+class PqStockCruiseControllerTest(unittest.TestCase):
+  def make_controller(self, mode=StockCruiseMode.lead_trim):
+    return PqStockCruiseController(mode, control_hz=10, lead_confirm_s=0.3, lead_lost_s=0.2,
+                                   button_interval_s=0.1, ack_timeout_s=0.3)
+
+  @staticmethod
+  def slower_lead(v_rel_ms=-2.8, d_rel_m=55.0, v_lead_ms=30.5):
+    return LeadSample(True, d_rel_m, 0.1, v_rel_ms, v_lead_ms, 0.95)
+
+  def test_missing_mode_file_defaults_off(self):
+    with tempfile.TemporaryDirectory() as tmp:
+      self.assertEqual(read_mode(Path(tmp) / "missing"), StockCruiseMode.off)
+
+  def test_manual_command_file_is_consumed(self):
+    with tempfile.TemporaryDirectory() as tmp:
+      path = Path(tmp) / "command"
+      path.write_text("down", encoding="utf-8")
+      self.assertEqual(consume_manual_command(path), ButtonCommand.decel)
+      self.assertFalse(path.exists())
+
+  def test_pq_button_message_preserves_stock_fields_and_sets_one_short_press(self):
+    stock = {"COUNTER": 4, "GRA_Sender": 2, "GRA_Hauptschalt": 1, "GRA_Up_kurz": 0,
+             "GRA_Down_kurz": 0, "GRA_Abbrechen": 0, "GRA_Recall": 0}
+    name, bus, values = pqcan.create_acc_buttons_control(FakePacker(), 2, stock, 5, decel=True)
+    self.assertEqual((name, bus), ("GRA_Neu", 2))
+    self.assertEqual(values["COUNTER"], 5)
+    self.assertEqual(values["GRA_Sender"], 2)
+    self.assertEqual(values["GRA_Hauptschalt"], 1)
+    self.assertEqual(values["GRA_Down_kurz"], True)
+    self.assertEqual(values["GRA_Up_kurz"], False)
+
+  def test_observe_mode_never_requests_button(self):
+    controller = self.make_controller(StockCruiseMode.observe)
+    outputs = [controller.update(True, 120.0, 33.3, lead=self.slower_lead()) for _ in range(10)]
+    self.assertTrue(all(output.command == ButtonCommand.none for output in outputs))
+    self.assertEqual(outputs[-1].temporary_target_kph, 110.0)
+
+  def test_lead_trim_waits_for_stable_lead_then_requests_one_decrement(self):
+    controller = self.make_controller()
+    outputs = [controller.update(True, 120.0, 33.3, lead=self.slower_lead()) for _ in range(3)]
+    self.assertEqual(outputs[0].command, ButtonCommand.none)
+    self.assertEqual(outputs[1].command, ButtonCommand.none)
